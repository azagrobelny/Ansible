- name: noshut_port
  hosts: 172.16.20.42
  gather_facts: no
  connection: network_cli
  become: true
  ignore_errors: yes

  vars:
    ansible_network_os: cisco.ios.ios
    # Lista portow do wlaczenia
    ports_to_disable:
      - Gi1/0/39
      - Gi1/0/28
      - Gi3/0/35
      - Gi9/0/13
      - Te9/0/25
      - Gi3/0/48
      - Gi1/0/38
      - G3/0/8
      - Gi1/0/24
      - Gi1/0/22
      - Gi1/0/35
      - Gi1/0/34
      - Gi1/0/13
      - Gi1/0/29
      - Gi2/0/11
      - Gi10/0/24
      - Gi2/0/46
      - Gi1/0/19
      - Gi3/0/4
      - Gi10/0/19
      - Gi3/0/28
      - Gi1/0/23
      - Gi2/0/16
      - Gi10/0/31
      - Gi1/0/43
      - Gi10/0/29
      - Gi2/0/3
      - Gi1/0/8
      - Gi2/0/1
      - Te9/0/43
      - Te9/0/43
      - Gi1/0/10
      - Gi10/0/22
  tasks:
    - name: Wlacz wybrane porty
      cisco.ios.ios_interfaces:
        config:
          - name: "{{ item }}"
            enabled: true
        state: merged
      loop: "{{ ports_to_disable }}"
